# CoderX Environment Configuration
# AI Provider API Keys

# OpenRouter API Key (recommended - provides access to many free and paid models)
# Get your free API key at: https://openrouter.ai/settings/keys
OPEN_ROUTER_API_KEY=your_openrouter_key_here

# Free models available through OpenRouter include:
# - openai/gpt-oss-20b:free (OpenAI 20B free model)
# - deepseek/deepseek-chat-v3.1:free
# - google/gemma-3n-e2b-it:free
# - nvidia/nemotron-nano-9b-v2:free
# And many more! Check https://openrouter.ai/models for full list

# Direct Provider API Keys (uncomment and add your keys as needed)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint_here
# COHERE_API_KEY=your_cohere_key_here
# HUGGINGFACE_API_KEY=your_huggingface_key_here
# GROQ_API_KEY=your_groq_key_here
# MISTRAL_API_KEY=your_mistral_key_here
# PERPLEXITY_API_KEY=your_perplexity_key_here
# DEEPSEEK_API_KEY=your_deepseek_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Supabase Configuration (uncomment and add your Supabase credentials)
# SUPABASE_URL=your_supabase_url_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Deployment Platform Tokens (uncomment and add your tokens as needed)
# NETLIFY_ACCESS_TOKEN=your_netlify_token_here
# VERCEL_ACCESS_TOKEN=your_vercel_token_here

# Git Platform Tokens (uncomment and add your tokens as needed)
# GITHUB_TOKEN=your_github_token_here
# GITLAB_TOKEN=your_gitlab_token_here

# MCP Server Configuration (uncomment and add your MCP server details)
# MCP_SERVER_URL=your_mcp_server_url_here
# MCP_SERVER_TOKEN=your_mcp_server_token_here
