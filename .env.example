# CoderX Universal API Key Configuration
# ======================================
# 
# 🎉 UNIVERSAL SYSTEM: Add ANY API key and it works automatically!
# The system auto-detects API key type and selects the best provider.
#
# ==========================================
# PRIMARY AI PROVIDERS (Choose ONE)
# ==========================================

# OpenAI API Key (sk-...)
# OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (sk-ant-...)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# OpenRouter API Key (sk-or-v1-...) - Access to many models
# OPEN_ROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Google AI API Key (AIza...)
# GOOGLE_API_KEY=AIza-your-google-key-here

# Azure OpenAI API Key
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ==========================================
# SPECIALIZED AI PROVIDERS
# ==========================================

# Groq API Key (gsk_...)
# GROQ_API_KEY=gsk_your-groq-key-here

# Cohere API Key (cohere-...)
# COHERE_API_KEY=cohere-your-cohere-key-here

# Mistral API Key (mistral-...)
# MISTRAL_API_KEY=mistral-your-mistral-key-here

# Perplexity API Key (pplx-...)
# PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# DeepSeek API Key (sk-...)
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Together AI API Key (sk-...)
# TOGETHER_API_KEY=sk-your-together-key-here

# XAI API Key (xai-...)
# XAI_API_KEY=xai-your-xai-key-here

# Hugging Face API Key (hf_...)
# HUGGINGFACE_API_KEY=hf_your-huggingface-key-here

# Moonshot API Key
# MOONSHOT_API_KEY=sk-your-moonshot-key-here

# Hyperbolic API Key
# HYPERBOLIC_API_KEY=sk-your-hyperbolic-key-here

# ==========================================
# LOCAL AI PROVIDERS
# ==========================================

# Ollama (Local AI)
# OLLAMA_BASE_URL=http://localhost:11434

# LM Studio (Local AI)
# LMSTUDIO_BASE_URL=http://localhost:1234

# ==========================================
# CLOUD AI PROVIDERS
# ==========================================

# Amazon Bedrock
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# ==========================================
# SERVICE INTEGRATIONS
# ==========================================

# Supabase (Database & Auth)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub Integration
# GITHUB_TOKEN=ghp_your-github-token

# GitLab Integration
# GITLAB_TOKEN=glpat-your-gitlab-token

# ==========================================
# DEPLOYMENT PLATFORMS
# ==========================================

# Netlify
# NETLIFY_ACCESS_TOKEN=your-netlify-token

# Vercel
# VERCEL_ACCESS_TOKEN=your-vercel-token

# ==========================================
# MCP SERVER CONFIGURATION
# ==========================================

# MCP Server
# MCP_SERVER_URL=your-mcp-server-url
# MCP_SERVER_TOKEN=your-mcp-server-token

# ==========================================
# CUSTOM API KEYS (Universal Detection)
# ==========================================
# 
# You can add ANY API key with ANY name:
# MY_CUSTOM_API_KEY=your-custom-key-here
# SPECIAL_TOKEN=your-special-token-here
# SECRET_KEY=your-secret-key-here
# COMPANY_API_KEY=your-company-key-here
#
# The system will automatically detect and use it!

# ==========================================
# USAGE INSTRUCTIONS
# ==========================================
#
# 🚀 QUICK START:
# 1. Copy this file to .env
# 2. Uncomment ONE API key line above
# 3. Add your actual API key
# 4. Run: npm run dev
# 5. System automatically detects and uses your API key!
#
# 🎯 WHAT HAPPENS AUTOMATICALLY:
# ✅ Auto-detects API key type and provider
# ✅ Auto-selects best available models
# ✅ Prefers free models when available
# ✅ Works end-to-end without configuration
# ✅ Handles all provider-specific details
#
# 📋 SUPPORTED MODELS BY PROVIDER:
#
# OpenAI: GPT-4, GPT-3.5, GPT-4o, GPT-4o-mini
# Anthropic: Claude-3.5-Sonnet, Claude-3-Haiku, Claude-3-Opus
# OpenRouter: Access to 100+ models from various providers
# Google: Gemini-Pro, Gemini-Pro-Vision, PaLM-2
# Groq: Llama-3, Mixtral, Gemma, Qwen
# Cohere: Command, Command-Light, Command-Nightly
# Mistral: Mistral-7B, Mixtral-8x7B, Codestral
# Perplexity: Sonar-Small, Sonar-Medium, Sonar-Large
# DeepSeek: DeepSeek-Coder, DeepSeek-Chat
# Together: Llama-2, CodeLlama, Vicuna
# XAI: Grok-1, Grok-2
# Hugging Face: 1000+ open-source models
# Moonshot: Moonshot-V1-8K, Moonshot-V1-32K
# Hyperbolic: Hyperbolic-7B, Hyperbolic-13B
#
# 🎉 UNIVERSAL API KEY SUPPORT - JUST ADD YOUR KEY AND GO!
