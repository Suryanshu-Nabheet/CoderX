# CoderX Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key
GOOGLE_API_KEY=your_google_api_key_here

# Cohere API Key
COHERE_API_KEY=your_cohere_api_key_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Together API Key
TOGETHER_API_KEY=your_together_api_key_here

# Perplexity API Key
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mistral API Key
MISTRAL_API_KEY=your_mistral_api_key_here

# Moonshot API Key
MOONSHOT_API_KEY=your_moonshot_api_key_here

# XAI API Key
XAI_API_KEY=your_xai_api_key_here

# Amazon Bedrock Access Key ID
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# Amazon Bedrock Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Amazon Bedrock Region
AWS_REGION=us-east-1

# GitHub Personal Access Token (for GitHub integration)
GITHUB_TOKEN=your_github_token_here

# GitLab Personal Access Token (for GitLab integration)
GITLAB_TOKEN=your_gitlab_token_here

# Supabase URL (for Supabase integration)
SUPABASE_URL=your_supabase_url_here

# Supabase Anon Key (for Supabase integration)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Netlify Personal Access Token (for Netlify integration)
NETLIFY_TOKEN=your_netlify_token_here

# Vercel Personal Access Token (for Vercel integration)
VERCEL_TOKEN=your_vercel_token_here
